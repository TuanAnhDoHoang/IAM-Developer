{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FullstackRead",
      "Effect": "Allow",
      "Action": [
        "lambda:*",
        "ecs:*",
        "ecr:*",
        "s3:Get*",
        "s3:List*",
        "dynamodb:Describe*",
        "dynamodb:List*",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "sqs:*",
        "sns:*",
        "events:*",
        "logs:*",
        "cloudwatch:*",
        "xray:*",
        "cloudformation:Describe*",
        "cloudformation:List*",
        "cloudformation:Get*",
        "codebuild:List*",
        "codebuild:BatchGet*",
        "codepipeline:List*",
        "codepipeline:Get*",
        "ec2:Describe*",
        "rds:Describe*",
        "secretsmanager:GetSecretValue",
        "ssm:Get*",
        "iam:Get*",
        "iam:List*",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "FullstackWrite",
      "Effect": "Allow",
      "Action": [
        "lambda:Create*",
        "lambda:Update*",
        "lambda:Delete*",
        "lambda:InvokeFunction",
        "lambda:Publish*",
        "ecs:RegisterTaskDefinition",
        "ecs:CreateService",
        "ecs:UpdateService",
        "ecs:DeleteService",
        "ecs:RunTask",
        "ecs:StopTask",
        "ecr:PutImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:CreateRepository",
        "s3:PutObject",
        "s3:DeleteObject",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:CreateChangeSet",
        "cloudformation:ExecuteChangeSet",
        "codebuild:StartBuild",
        "codepipeline:StartPipelineExecution",
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassRoleLimited",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::*:role/lambda*",
        "arn:aws:iam::*:role/ecs*",
        "arn:aws:iam::*:role/*ServiceRole*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "ecs-tasks.amazonaws.com",
            "ecs.amazonaws.com",
            "codebuild.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DenyHighRisk",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:AttachRolePolicy",
        "iam:PutRolePolicy",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "organizations:*",
        "account:*",
        "ec2:CreateVpc",
        "ec2:DeleteVpc",
        "rds:DeleteDBInstance",
        "s3:DeleteBucket",
        "s3:PutBucketPolicy",
        "cloudformation:DeleteStack"
      ],
      "Resource": "*"
    }
  ]
}
