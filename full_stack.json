{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FullstackRead",
      "Effect": "Allow",
      "Action": [
        "lambda:*",
        "ecs:*",
        "ecr:*",
        "s3:Get*",
        "s3:List*",
        "dynamodb:Describe*",
        "dynamodb:List*",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "sqs:*",
        "sns:*",
        "events:*",
        "logs:*",
        "cloudwatch:*",
        "xray:*",
        "cloudformation:Describe*",
        "cloudformation:List*",
        "cloudformation:Get*",
        "codebuild:List*",
        "codebuild:BatchGet*",
        "codepipeline:List*",
        "codepipeline:Get*",
        "ec2:Describe*",
        "rds:Describe*",
        "secretsmanager:GetSecretValue",
        "ssm:Get*",
        "iam:Get*",
        "iam:List*",
        "sts:GetCallerIdentity"
      ],
      "Resource": [
        "arn:aws:lambda:<region>:<account-id>:function:<function-name>",
        "arn:aws:ecs:<region>:<account-id>:cluster/<cluster-name>",
        "arn:aws:ecs:<region>:<account-id>:service/<cluster-name>/<service-name>",
        "arn:aws:ecs:<region>:<account-id>:task-definition/<task-family>:*",
        "arn:aws:ecr:<region>:<account-id>:repository/<repository-name>",
        "arn:aws:s3:::<bucket-name>/*",
        "arn:aws:dynamodb:<region>:<account-id>:table/<table-name>",
        "arn:aws:sqs:<region>:<account-id>:<queue-name>",
        "arn:aws:sns:<region>:<account-id>:<topic-name>",
        "arn:aws:events:<region>:<account-id>:rule/<rule-name>",
        "arn:aws:logs:<region>:<account-id>:log-group:<log-group-name>",
        "arn:aws:logs:<region>:<account-id>:log-group:<log-group-name>:*",
        "arn:aws:cloudwatch:<region>:<account-id>:alarm/<alarm-name>",
        "arn:aws:xray:<region>:<account-id>:group/<group-name>",
        "arn:aws:cloudformation:<region>:<account-id>:stack/<stack-name>/*",
        "arn:aws:codebuild:<region>:<account-id>:project/<project-name>",
        "arn:aws:codepipeline:<region>:<account-id>:pipeline/<pipeline-name>",
        "arn:aws:ec2:<region>:<account-id>:instance/*",
        "arn:aws:rds:<region>:<account-id>:db:<db-instance-identifier>",
        "arn:aws:secretsmanager:<region>:<account-id>:secret:<secret-name>*",
        "arn:aws:ssm:<region>:<account-id>:parameter/<parameter-path>",
        "arn:aws:iam::<account-id>:role/<role-name>"
      ]
    },
    {
      "Sid": "FullstackWrite",
      "Effect": "Allow",
      "Action": [
        "lambda:Create*",
        "lambda:Update*",
        "lambda:Delete*",
        "lambda:InvokeFunction",
        "lambda:Publish*",
        "ecs:RegisterTaskDefinition",
        "ecs:CreateService",
        "ecs:UpdateService",
        "ecs:DeleteService",
        "ecs:RunTask",
        "ecs:StopTask",
        "ecr:PutImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:CreateRepository",
        "s3:PutObject",
        "s3:DeleteObject",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:CreateChangeSet",
        "cloudformation:ExecuteChangeSet",
        "codebuild:StartBuild",
        "codepipeline:StartPipelineExecution",
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:lambda:<region>:<account-id>:function:<function-name>",
        "arn:aws:ecs:<region>:<account-id>:cluster/<cluster-name>",
        "arn:aws:ecs:<region>:<account-id>:service/<cluster-name>/<service-name>",
        "arn:aws:ecs:<region>:<account-id>:task-definition/<task-family>:*",
        "arn:aws:ecr:<region>:<account-id>:repository/<repository-name>",
        "arn:aws:s3:::<bucket-name>/*",
        "arn:aws:dynamodb:<region>:<account-id>:table/<table-name>",
        "arn:aws:cloudformation:<region>:<account-id>:stack/<stack-name>/*",
        "arn:aws:codebuild:<region>:<account-id>:project/<project-name>",
        "arn:aws:codepipeline:<region>:<account-id>:pipeline/<pipeline-name>",
        "arn:aws:logs:<region>:<account-id>:log-group:<log-group-name>",
        "arn:aws:logs:<region>:<account-id>:log-group:<log-group-name>:*"
      ]
    },
    {
      "Sid": "PassRoleLimited",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::<account-id>:role/<lambda-execution-role-name>",
        "arn:aws:iam::<account-id>:role/<ecs-task-role-name>",
        "arn:aws:iam::<account-id>:role/<service-role-name>"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "ecs-tasks.amazonaws.com",
            "ecs.amazonaws.com",
            "codebuild.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DenyHighRisk",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:AttachRolePolicy",
        "iam:PutRolePolicy",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "organizations:*",
        "account:*",
        "ec2:CreateVpc",
        "ec2:DeleteVpc",
        "rds:DeleteDBInstance",
        "s3:DeleteBucket",
        "s3:PutBucketPolicy",
        "cloudformation:DeleteStack"
      ],
      "Resource": "*"
    }
  ]
}
