{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ContainerRead",
      "Effect": "Allow",
      "Action": [
        "ecs:Describe*",
        "ecs:List*",
        "ecr:Describe*",
        "ecr:List*",
        "ecr:Get*",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability",
        "logs:Describe*",
        "logs:Get*",
        "logs:FilterLogEvents",
        "s3:ListBucket",
        "s3:GetObject",
        "elasticloadbalancing:Describe*",
        "cloudformation:Describe*",
        "cloudformation:List*",
        "secretsmanager:GetSecretValue",
        "ssm:GetParameter*",
        "iam:Get*",
        "iam:List*",
        "sts:GetCallerIdentity"
      ],
      "Resource": [
        "arn:aws:ecs:<region>:<account-id>:cluster/<cluster-name>",
        "arn:aws:ecs:<region>:<account-id>:service/<cluster-name>/<service-name>",
        "arn:aws:ecs:<region>:<account-id>:task-definition/<task-family>:*",
        "arn:aws:ecr:<region>:<account-id>:repository/<repository-name>",
        "arn:aws:elasticloadbalancing:<region>:<account-id>:loadbalancer/<load-balancer-name>",
        "arn:aws:logs:<region>:<account-id>:log-group:/aws/ecs/<cluster-name>",
        "arn:aws:logs:<region>:<account-id>:log-group:/aws/ecs/<cluster-name>/*",
        "arn:aws:s3:::<bucket-name>/*",
        "arn:aws:secretsmanager:<region>:<account-id>:secret:<secret-name>*",
        "arn:aws:ssm:<region>:<account-id>:parameter/<parameter-path>",
        "arn:aws:cloudformation:<region>:<account-id>:stack/<stack-name>/*",
        "arn:aws:iam::<account-id>:role/<role-name>"
      ]
    },
    {
      "Sid": "ContainerWrite",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DeregisterTaskDefinition",
        "ecs:CreateService",
        "ecs:UpdateService",
        "ecs:DeleteService",
        "ecs:RunTask",
        "ecs:StopTask",
        "ecs:StartTask",
        "ecr:CreateRepository",
        "ecr:PutImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:DeleteRepository",
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "s3:PutObject",
        "s3:DeleteObject",
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:CreateChangeSet",
        "cloudformation:ExecuteChangeSet"
      ],
      "Resource": [
        "arn:aws:ecs:<region>:<account-id>:cluster/<cluster-name>",
        "arn:aws:ecs:<region>:<account-id>:service/<cluster-name>/<service-name>",
        "arn:aws:ecs:<region>:<account-id>:task-definition/<task-family>:*",
        "arn:aws:ecr:<region>:<account-id>:repository/<repository-name>",
        "arn:aws:logs:<region>:<account-id>:log-group:/aws/ecs/<cluster-name>",
        "arn:aws:logs:<region>:<account-id>:log-group:/aws/ecs/<cluster-name>/*",
        "arn:aws:s3:::<bucket-name>/*",
        "arn:aws:cloudformation:<region>:<account-id>:stack/<stack-name>/*"
      ]
    },
    {
      "Sid": "PassRoleForECS",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::<account-id>:role/<ecs-task-execution-role-name>",
        "arn:aws:iam::<account-id>:role/<ecs-service-role-name>",
        "arn:aws:iam::<account-id>:role/<ecs-task-role-name>"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ecs-tasks.amazonaws.com",
            "ecs.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DenyDangerous",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "ec2:Create*",
        "ec2:Delete*",
        "ec2:Modify*",
        "s3:DeleteBucket",
        "cloudformation:DeleteStack"
      ],
      "Resource": "*"
    }
  ]
}
