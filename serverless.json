{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ServerlessRead",
      "Effect": "Allow",
      "Action": [
        "lambda:List*",
        "lambda:Get*",
        "apigateway:GET",
        "apigateway:HEAD",
        "dynamodb:Describe*",
        "dynamodb:List*",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "events:List*",
        "events:Describe*",
        "sqs:List*",
        "sqs:Get*",
        "sqs:ReceiveMessage",
        "sns:List*",
        "sns:Get*",
        "logs:Describe*",
        "logs:Get*",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:GetQueryResults",
        "xray:Get*",
        "xray:BatchGet*",
        "cloudformation:Describe*",
        "cloudformation:List*",
        "cloudformation:Get*",
        "secretsmanager:GetSecretValue",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "iam:Get*",
        "iam:List*",
        "sts:GetCallerIdentity"
      ],
      "Resource": [
        "arn:aws:lambda:<region>:<account-id>:function:<function-name>",
        "arn:aws:apigateway:<region>::/restapis/<api-id>",
        "arn:aws:apigateway:<region>::/restapis/<api-id>/stages/<stage-name>",
        "arn:aws:dynamodb:<region>:<account-id>:table/<table-name>",
        "arn:aws:s3:::<bucket-name>/*",
        "arn:aws:events:<region>:<account-id>:rule/<rule-name>",
        "arn:aws:sqs:<region>:<account-id>:<queue-name>",
        "arn:aws:sns:<region>:<account-id>:<topic-name>",
        "arn:aws:logs:<region>:<account-id>:log-group:/aws/lambda/<function-name>",
        "arn:aws:logs:<region>:<account-id>:log-group:/aws/lambda/<function-name>:*",
        "arn:aws:xray:<region>:<account-id>:group/<group-name>",
        "arn:aws:cloudformation:<region>:<account-id>:stack/<stack-name>/*",
        "arn:aws:secretsmanager:<region>:<account-id>:secret:<secret-name>*",
        "arn:aws:ssm:<region>:<account-id>:parameter/<parameter-path>",
        "arn:aws:iam::<account-id>:role/<role-name>"
      ]
    },
    {
      "Sid": "ServerlessWrite",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:InvokeFunction",
        "lambda:PublishVersion",
        "lambda:CreateAlias",
        "lambda:UpdateAlias",
        "lambda:DeleteAlias",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:CreateEventSourceMapping",
        "lambda:UpdateEventSourceMapping",
        "lambda:DeleteEventSourceMapping",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchWriteItem",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "events:PutRule",
        "events:PutTargets",
        "events:RemoveTargets",
        "events:DeleteRule",
        "sqs:SendMessage",
        "sqs:DeleteMessage",
        "sqs:PurgeQueue",
        "sns:Publish",
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:PutRetentionPolicy",
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:CreateChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet"
      ],
      "Resource": [
        "arn:aws:lambda:<region>:<account-id>:function:<function-name>",
        "arn:aws:apigateway:<region>::/restapis/<api-id>",
        "arn:aws:apigateway:<region>::/restapis/<api-id>/stages/<stage-name>",
        "arn:aws:dynamodb:<region>:<account-id>:table/<table-name>",
        "arn:aws:s3:::<bucket-name>/*",
        "arn:aws:events:<region>:<account-id>:rule/<rule-name>",
        "arn:aws:sqs:<region>:<account-id>:<queue-name>",
        "arn:aws:sns:<region>:<account-id>:<topic-name>",
        "arn:aws:logs:<region>:<account-id>:log-group:/aws/lambda/<function-name>",
        "arn:aws:logs:<region>:<account-id>:log-group:/aws/lambda/<function-name>:*",
        "arn:aws:cloudformation:<region>:<account-id>:stack/<stack-name>/*"
      ]
    },
    {
      "Sid": "PassRoleForLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<account-id>:role/<lambda-execution-role-name>",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyDangerous",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "organizations:*",
        "account:*",
        "s3:DeleteBucket",
        "s3:PutBucketPolicy",
        "dynamodb:DeleteTable",
        "cloudformation:DeleteStack"
      ],
      "Resource": "*"
    }
  ]
}
